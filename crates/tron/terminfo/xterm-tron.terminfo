# terminfo entry for the tron terminal emulator.
# Based on xterm-256color, plus capabilities tron supports beyond it.
xterm-tron|tron terminal emulator,
	use=xterm-256color,
	Tc,
	RGB,
	setrgbf=\E[38:2::%p1%d:%p2%d:%p3%dm,
	setrgbb=\E[48:2::%p1%d:%p2%d:%p3%dm,
	Smulx=\E[4:%p1%dm,
	Setulc=\E[58:2::%p1%{65536}%/%d:%p1%{256}%/%{255}%&%d:%p1%{255}%&%d%;m,
	Ss=\E[%p1%d q,
	Se=\E[2 q,
	Sync=\E[?2026%?%p1%{1}%-%tl%eh%;,
	BD=\E[?2004l,
	BE=\E[?2004h,
	PS=\E[200~,
	PE=\E[201~,
	XM=\E[?1006;1000%?%p1%{1}%=%th%el%;,
	xm=\E[<%i%p3%d;%p1%d;%p2%d;%?%p4%tM%em%;,
	fe=\E[?1004h,
	fd=\E[?1004l,
	kxIN=\E[I,
	kxOUT=\E[O,
